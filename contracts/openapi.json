{
  "components": {
    "schemas": {
      "Category": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "title": "Category",
        "type": "object"
      },
      "DemoUser": {
        "description": "Usuario precargado, para que la pantalla de ingreso muestre con quién entrar.",
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "name",
          "role"
        ],
        "title": "DemoUser",
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorCode": {
        "enum": [
          "not_authenticated",
          "forbidden",
          "not_found",
          "already_taken",
          "action_not_allowed"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "password": {
            "description": "Se ignora: el ingreso es simulado y la contraseña nunca se guarda.",
            "format": "password",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password",
            "type": "string",
            "writeOnly": true
          },
          "username": {
            "description": "Letras minúsculas, números, punto, guion y guion bajo (1 a 50). Se recorta y se pasa a minúsculas.",
            "pattern": "^[a-z0-9._-]{1,50}$",
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "LoginResponse": {
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "token_type": {
            "const": "bearer",
            "title": "Token Type",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        },
        "required": [
          "access_token",
          "token_type",
          "expires_at",
          "user"
        ],
        "title": "LoginResponse",
        "type": "object"
      },
      "Priority": {
        "enum": [
          "critical",
          "high",
          "medium",
          "low"
        ],
        "title": "Priority",
        "type": "string"
      },
      "Role": {
        "enum": [
          "requester",
          "agent"
        ],
        "title": "Role",
        "type": "string"
      },
      "SlaPolicy": {
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "priority": {
            "$ref": "#/components/schemas/Priority"
          },
          "rank": {
            "title": "Rank",
            "type": "integer"
          },
          "target_amount": {
            "title": "Target Amount",
            "type": "integer"
          },
          "target_unit": {
            "$ref": "#/components/schemas/TargetUnit"
          }
        },
        "required": [
          "priority",
          "rank",
          "label",
          "description",
          "target_amount",
          "target_unit"
        ],
        "title": "SlaPolicy",
        "type": "object"
      },
      "TargetUnit": {
        "enum": [
          "hours",
          "days"
        ],
        "title": "TargetUnit",
        "type": "string"
      },
      "User": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "name",
          "email",
          "role"
        ],
        "title": "User",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "description": "Token emitido por `POST /api/v1/auth/login`.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "DroiDesk API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "read_health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Read Health"
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "description": "Ingreso simulado: cualquier contraseña sirve, pero el usuario debe existir.\n\nNunca crea usuarios: entra con el perfil que el usuario ya tiene.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "El usuario no existe."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login",
        "tags": [
          "identity"
        ]
      }
    },
    "/api/v1/auth/users": {
      "get": {
        "description": "Usuarios precargados de la demo, solicitantes primero. Solo alimenta la ayuda del ingreso.",
        "operationId": "list_demo_users",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DemoUser"
                  },
                  "title": "Response List Demo Users",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Demo Users",
        "tags": [
          "identity"
        ]
      }
    },
    "/api/v1/categories": {
      "get": {
        "operationId": "list_categories",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Category"
                  },
                  "title": "Response List Categories",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No autenticado: falta el token, es inválido o expiró."
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Categories",
        "tags": [
          "tickets"
        ]
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "read_me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No autenticado: falta el token, es inválido o expiró."
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Read Me",
        "tags": [
          "identity"
        ]
      }
    },
    "/api/v1/sla-policies": {
      "get": {
        "operationId": "list_sla_policies",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SlaPolicy"
                  },
                  "title": "Response List Sla Policies",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No autenticado: falta el token, es inválido o expiró."
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Sla Policies",
        "tags": [
          "sla"
        ]
      }
    }
  }
}
