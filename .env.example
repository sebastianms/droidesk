# Copia este archivo a .env o ejecuta ./setup.sh, que lo genera por ti.

# Secreto para firmar los JWT (mínimo 32 bytes). setup.sh lo genera; no lo versiones.
DROIDESK_JWT_SECRET=

DROIDESK_DATABASE_URL=sqlite:////data/droidesk.db

# Modo de arranque. Los usuarios de demo, las categorías y las políticas de SLA se cargan
# siempre; el modo decide si además hay tickets de ejemplo. Cambiar de modo no borra datos:
# los tickets de ejemplo (demo) se cargan solo mientras no exista ningún ticket.
#   demo  = usuarios y tickets de ejemplo en distintos estados, con comentarios e historial.
#   empty = solo los usuarios de demo, sin tickets.
DROIDESK_MODE=demo

# Zona horaria IANA y jornada laboral (HH:MM-HH:MM) con las que se calcula el SLA.
DROIDESK_TIMEZONE=America/Santiago
DROIDESK_BUSINESS_HOURS=09:00-18:00

# Puerto del host donde se publica la web (solo lo lee Compose).
DROIDESK_WEB_PORT=8080
