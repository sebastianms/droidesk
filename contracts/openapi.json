{
  "components": {
    "schemas": {
      "Category": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "title": "Category",
        "type": "object"
      },
      "DemoUser": {
        "description": "Usuario precargado, para que la pantalla de ingreso muestre con quién entrar.",
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "name",
          "role"
        ],
        "title": "DemoUser",
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorCode": {
        "enum": [
          "not_authenticated",
          "forbidden",
          "not_found",
          "already_taken",
          "action_not_allowed"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "password": {
            "description": "Se ignora: el ingreso es simulado y la contraseña nunca se guarda.",
            "format": "password",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password",
            "type": "string",
            "writeOnly": true
          },
          "username": {
            "description": "Letras minúsculas, números, punto, guion y guion bajo (1 a 50). Se recorta y se pasa a minúsculas.",
            "pattern": "^[a-z0-9._-]{1,50}$",
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "LoginResponse": {
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "token_type": {
            "const": "bearer",
            "title": "Token Type",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        },
        "required": [
          "access_token",
          "token_type",
          "expires_at",
          "user"
        ],
        "title": "LoginResponse",
        "type": "object"
      },
      "Priority": {
        "enum": [
          "critical",
          "high",
          "medium",
          "low"
        ],
        "title": "Priority",
        "type": "string"
      },
      "Role": {
        "enum": [
          "requester",
          "agent"
        ],
        "title": "Role",
        "type": "string"
      },
      "Sla": {
        "description": "Estado del SLA; `due_at` es nulo mientras está en pausa y en los tickets cancelados.",
        "properties": {
          "due_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Due At"
          },
          "state": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SlaState"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "state",
          "due_at"
        ],
        "title": "Sla",
        "type": "object"
      },
      "SlaPolicy": {
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "priority": {
            "$ref": "#/components/schemas/Priority"
          },
          "rank": {
            "title": "Rank",
            "type": "integer"
          },
          "target_amount": {
            "title": "Target Amount",
            "type": "integer"
          },
          "target_unit": {
            "$ref": "#/components/schemas/TargetUnit"
          }
        },
        "required": [
          "priority",
          "rank",
          "label",
          "description",
          "target_amount",
          "target_unit"
        ],
        "title": "SlaPolicy",
        "type": "object"
      },
      "SlaState": {
        "enum": [
          "on_track",
          "at_risk",
          "breached",
          "paused",
          "met",
          "missed"
        ],
        "title": "SlaState",
        "type": "string"
      },
      "TargetUnit": {
        "enum": [
          "hours",
          "days"
        ],
        "title": "TargetUnit",
        "type": "string"
      },
      "TicketAction": {
        "enum": [
          "take",
          "cancel",
          "hold",
          "resume",
          "resolve",
          "close",
          "reopen",
          "comment",
          "change_priority"
        ],
        "title": "TicketAction",
        "type": "string"
      },
      "TicketCreate": {
        "properties": {
          "category_id": {
            "title": "Category Id",
            "type": "integer"
          },
          "description": {
            "maxLength": 5000,
            "minLength": 1,
            "title": "Description",
            "type": "string"
          },
          "priority": {
            "$ref": "#/components/schemas/Priority",
            "default": "medium"
          },
          "title": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title",
          "description",
          "category_id"
        ],
        "title": "TicketCreate",
        "type": "object"
      },
      "TicketDetail": {
        "properties": {
          "allowed_actions": {
            "items": {
              "$ref": "#/components/schemas/TicketAction"
            },
            "title": "Allowed Actions",
            "type": "array"
          },
          "assignee": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/UserRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "cancelled_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cancelled At"
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "closed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Closed At"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "priority": {
            "$ref": "#/components/schemas/Priority"
          },
          "requester": {
            "$ref": "#/components/schemas/UserRef"
          },
          "resolved_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resolved At"
          },
          "sla": {
            "$ref": "#/components/schemas/Sla"
          },
          "status": {
            "$ref": "#/components/schemas/TicketStatus"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "status",
          "priority",
          "category",
          "requester",
          "assignee",
          "created_at",
          "sla",
          "description",
          "resolved_at",
          "closed_at",
          "cancelled_at",
          "allowed_actions"
        ],
        "title": "TicketDetail",
        "type": "object"
      },
      "TicketStatus": {
        "enum": [
          "open",
          "in_progress",
          "on_hold",
          "resolved",
          "closed",
          "cancelled"
        ],
        "title": "TicketStatus",
        "type": "string"
      },
      "TicketSummary": {
        "properties": {
          "assignee": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/UserRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "priority": {
            "$ref": "#/components/schemas/Priority"
          },
          "requester": {
            "$ref": "#/components/schemas/UserRef"
          },
          "sla": {
            "$ref": "#/components/schemas/Sla"
          },
          "status": {
            "$ref": "#/components/schemas/TicketStatus"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "status",
          "priority",
          "category",
          "requester",
          "assignee",
          "created_at",
          "sla"
        ],
        "title": "TicketSummary",
        "type": "object"
      },
      "TicketView": {
        "enum": [
          "mine",
          "queue",
          "assigned"
        ],
        "title": "TicketView",
        "type": "string"
      },
      "TransitionRequest": {
        "properties": {
          "action": {
            "enum": [
              "take",
              "cancel",
              "hold",
              "resume",
              "resolve",
              "close",
              "reopen"
            ],
            "title": "Action",
            "type": "string"
          }
        },
        "required": [
          "action"
        ],
        "title": "TransitionRequest",
        "type": "object"
      },
      "User": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "name",
          "email",
          "role"
        ],
        "title": "User",
        "type": "object"
      },
      "UserRef": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "title": "UserRef",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "description": "Token emitido por `POST /api/v1/auth/login`.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "DroiDesk API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "read_health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Read Health"
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "description": "Ingreso simulado: cualquier contraseña sirve, pero el usuario debe existir.\n\nNunca crea usuarios: entra con el perfil que el usuario ya tiene.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "El usuario no existe."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login",
        "tags": [
          "identity"
        ]
      }
    },
    "/api/v1/auth/users": {
      "get": {
        "description": "Usuarios precargados de la demo, solicitantes primero. Solo alimenta la ayuda del ingreso.",
        "operationId": "list_demo_users",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DemoUser"
                  },
                  "title": "Response List Demo Users",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Demo Users",
        "tags": [
          "identity"
        ]
      }
    },
    "/api/v1/categories": {
      "get": {
        "operationId": "list_categories",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Category"
                  },
                  "title": "Response List Categories",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No autenticado: falta el token, es inválido o expiró."
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Categories",
        "tags": [
          "tickets"
        ]
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "read_me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No autenticado: falta el token, es inválido o expiró."
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Read Me",
        "tags": [
          "identity"
        ]
      }
    },
    "/api/v1/sla-policies": {
      "get": {
        "operationId": "list_sla_policies",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SlaPolicy"
                  },
                  "title": "Response List Sla Policies",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No autenticado: falta el token, es inválido o expiró."
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Sla Policies",
        "tags": [
          "sla"
        ]
      }
    },
    "/api/v1/tickets": {
      "get": {
        "description": "Lista según el perfil.\n\n- Solicitante: `mine` (por defecto), sus tickets del más reciente al más antiguo.\n- Agente: `queue` (por defecto), los tickets no finales; y `assigned`, los suyos.\n  Ambas van por vencimiento: primero el reloj corriendo, luego los en espera.\n\nPedir una vista que no es de su perfil responde 403.",
        "operationId": "list_tickets",
        "parameters": [
          {
            "in": "query",
            "name": "view",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/TicketView"
                },
                {
                  "type": "null"
                }
              ],
              "title": "View"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/TicketSummary"
                  },
                  "title": "Response List Tickets",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No autenticado: falta el token, es inválido o expiró."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "El perfil del usuario no permite la operación."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Tickets",
        "tags": [
          "tickets"
        ]
      },
      "post": {
        "operationId": "create_ticket",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TicketCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No autenticado: falta el token, es inválido o expiró."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "El perfil del usuario no permite la operación."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Create Ticket",
        "tags": [
          "tickets"
        ]
      }
    },
    "/api/v1/tickets/{ticket_id}": {
      "get": {
        "operationId": "read_ticket",
        "parameters": [
          {
            "in": "path",
            "name": "ticket_id",
            "required": true,
            "schema": {
              "title": "Ticket Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No autenticado: falta el token, es inválido o expiró."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No encontrado. Un ticket ajeno se informa igual que uno inexistente."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Read Ticket",
        "tags": [
          "tickets"
        ]
      }
    },
    "/api/v1/tickets/{ticket_id}/transitions": {
      "post": {
        "description": "Aplica una acción de estado; `allowed_actions` del ticket dice cuáles ofrecer.\n\n403 si el perfil nunca puede hacerla; 409 `already_taken` si otro agente tomó el\nticket primero y 409 `action_not_allowed` si el estado o la relación con el ticket\nno la permiten.",
        "operationId": "transition_ticket",
        "parameters": [
          {
            "in": "path",
            "name": "ticket_id",
            "required": true,
            "schema": {
              "title": "Ticket Id",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransitionRequest"
              }
            }
