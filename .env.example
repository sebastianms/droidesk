# Copia este archivo a .env o ejecuta ./setup.sh, que lo genera por ti.

# Secreto para firmar los JWT (mínimo 32 bytes). setup.sh lo genera; no lo versiones.
DROIDESK_JWT_SECRET=

DROIDESK_DATABASE_URL=sqlite:////data/droidesk.db
DROIDESK_SEED_DEMO_DATA=true
DROIDESK_TIMEZONE=America/Santiago
DROIDESK_BUSINESS_HOURS=09:00-18:00

# Puerto del host donde se publica la web (solo lo lee Compose).
DROIDESK_WEB_PORT=8080
